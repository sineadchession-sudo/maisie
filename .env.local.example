# Kit (ConvertKit) API credentials
# Get your API key from: https://app.kit.com/account_settings/developer_settings
KIT_API_KEY=your_kit_api_key_here

# Your Kit form ID — found in the URL when editing a form in Kit
# e.g. https://app.kit.com/forms/1234567/edit  →  KIT_FORM_ID=1234567
KIT_FORM_ID=your_form_id_here

# Google Search Console verification
# Leave blank until you get the value from Google Search Console (see README)
GOOGLE_SITE_VERIFICATION=
